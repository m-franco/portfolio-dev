---
import ExperienceItem from "./ExperienceItem.astro"
import { ui, type Lang } from "@/i18n/ui";

interface Props {
    lang?: Lang;
}

const lang = Astro.props.lang ?? "en";
const experience = ui[lang].experience;
---
<ol class="relative border-s border-gray-200 ml-3">
    {experience.items.map(item => (
        <li class="mb-10 ms-4">
            <ExperienceItem {...item} learnMore={experience.learnMore}/>
        </li>
       
    ))}              
</ol>
