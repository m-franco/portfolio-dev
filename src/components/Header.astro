---
import { LANG_FLAGS, LANG_NAMES, LANGS, hashUrl, homeUrl, ui, type Lang } from '@/i18n/ui';

interface Props {
    lang?: Lang;
}

const lang = Astro.props.lang ?? "en";
const copy = ui[lang].nav;
---

<header
    class="
        header-shell relative flex items-start justify-center
        mx-auto
        px-3 py-3 sm:py-5
        sticky top-0
        w-full xl:w-[1120px]
        z-10
">

    <nav
        class={`
            nav-pill
            border border-black rounded-full 
            h-8 px-1 sm:h-9 sm:px-2
            flex max-w-[calc(100vw-6rem)] flex-row flex-nowrap items-center justify-center
            bg-black/30
            dark:bg-black/50
            backdrop-blur-2xl
            text-[9px] min-[380px]:text-[10px] sm:max-w-none sm:text-base
        `}
        aria-label="Primary navigation"
    >
        <a
        class="whitespace-nowrap hover:bg-white/10 rounded-full px-1 py-1 transition sm:px-3"
        href={hashUrl(lang, "experience")}>{copy.experience}</a>
        <a
        class="whitespace-nowrap hover:bg-white/10 rounded-full px-1 py-1 transition sm:px-3"
        href={hashUrl(lang, "projects")}>{copy.projects}</a>
        <a
        class="whitespace-nowrap hover:bg-white/10 rounded-full px-1 py-1 transition sm:px-3"
        href={hashUrl(lang, "about-me")}>{copy.about}</a>
        <a
        class="whitespace-nowrap hover:bg-white/10 rounded-full px-1 py-1 transition sm:px-3"
        href={hashUrl(lang, "contact")}>{copy.contact}</a>
    </nav>

    <details
        class="lang-switcher group absolute right-3 top-3 h-8 shrink-0 rounded-full border border-black bg-black/30 px-3 text-sm backdrop-blur-2xl dark:bg-black/50 sm:top-5 sm:h-9 sm:text-base"
        id="lang-switcher"
    >
        <summary
            class="flex h-full cursor-pointer list-none items-center gap-2 rounded-full transition hover:bg-white/10 focus:outline-none focus-visible:bg-white/10 [&::-webkit-details-marker]:hidden"
            aria-label="Idioma / Language"
        >
            <span>{LANG_FLAGS[lang]}</span>
            <span class="hidden sm:inline">{LANG_NAMES[lang]}</span>
            <svg
                class="size-3 transition group-open:rotate-180"
                viewBox="0 0 12 8"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
            >
                <path d="M1 1.5l5 5 5-5"></path>
            </svg>
        </summary>
        <ul class="absolute right-0 mt-2 min-w-max rounded-xl border border-black bg-black/90 p-1 shadow-2xl backdrop-blur-2xl">
            {LANGS.map((item) => (
                <li>
                    <a
                        href={homeUrl(item)}
                        hreflang={item}
                        class={`flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-white transition hover:bg-white/10 ${item === lang ? "font-semibold text-cyan-100" : ""}`}
                    >
                        <span>{LANG_FLAGS[item]}</span>
                        <span>{LANG_NAMES[item]}</span>
                        {item === lang && <span class="ml-auto text-cyan-200">✓</span>}
                    </a>
                </li>
            ))}
        </ul>
    </details>
</header>
<script is:inline>
    (() => {
        const switcher = document.getElementById("lang-switcher");
        if (!switcher) return;
        document.addEventListener("click", (event) => {
            if (!switcher.contains(event.target)) switcher.removeAttribute("open");
        });
        window.addEventListener("pageshow", () => switcher.removeAttribute("open"));
    })();
</script>
<style>
    @media (max-width: 430px) {
        .nav-pill {
            max-width: calc(100vw - 5.25rem);
        }
    }
</style>
